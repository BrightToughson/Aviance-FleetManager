{
  "expo": {
    "name": "Aviance FleetManager",
    "slug": "AvianceFleetManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/logo.png",
    "scheme": "aviancefleetmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aviance Fleet Manager to access your camera to scan vehicle QR codes for quick access."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
